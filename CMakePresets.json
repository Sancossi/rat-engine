{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-release",
      "displayName": "Development Release (editor and tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RAT_BUILD_EDITOR": "ON",
        "RAT_BUILD_TESTS": "ON",
        "RAT_BUILD_RENDERER": "ON",
        "RAT_BUILD_GUI_TESTS": "OFF"
      }
    },
    {
      "name": "dev-debug",
      "inherits": "dev-release",
      "binaryDir": "${sourceDir}/build/dev-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "headless-release",
      "inherits": "dev-release",
      "displayName": "Release core/editor logic, no graphics or audio dependencies",
      "binaryDir": "${sourceDir}/build/headless-release",
      "cacheVariables": {
        "RAT_BUILD_RENDERER": "OFF",
        "RAT_BUILD_EDITOR": "OFF",
        "RAT_BUILD_GUI_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-release",
      "configurePreset": "dev-release"
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release"
    }
  ],
  "testPresets": [
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120,
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120,
        "noTestsAction": "error"
      }
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120,
        "noTestsAction": "error"
      }
    }
  ]
}
