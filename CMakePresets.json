{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-release",
      "displayName": "Development Release (editor and tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RAT_BUILD_EDITOR": "ON",
        "RAT_BUILD_TESTS": "ON",
        "RAT_BUILD_RENDERER": "ON",
        "RAT_BUILD_GUI_TESTS": "OFF",
        "RAT_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "dev-debug",
      "inherits": "dev-release",
      "binaryDir": "${sourceDir}/build/dev-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "headless-release",
      "inherits": "dev-release",
      "displayName": "Release core/editor logic, no graphics or audio dependencies",
      "binaryDir": "${sourceDir}/build/headless-release",
      "cacheVariables": {
        "RAT_BUILD_RENDERER": "OFF",
        "RAT_BUILD_EDITOR": "OFF",
        "RAT_BUILD_GUI_TESTS": "OFF"
      }
    },
    {
      "name": "gui-release",
      "inherits": "dev-release",
      "displayName": "Release with full real-editor GUI acceptance",
      "binaryDir": "${sourceDir}/build/gui-release",
      "cacheVariables": {
        "RAT_BUILD_GUI_TESTS": "ON"
      }
    },
    {
      "name": "headless-sanitizers",
      "inherits": "headless-release",
      "displayName": "Linux Debug headless ASan and UBSan",
      "binaryDir": "${sourceDir}/build/headless-sanitizers",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RAT_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-release",
      "configurePreset": "dev-release"
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release"
    },
    {
      "name": "gui-release",
      "configurePreset": "gui-release"
    },
    {
      "name": "headless-sanitizers",
      "configurePreset": "headless-sanitizers"
    }
  ],
  "testPresets": [
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120,
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120,
        "noTestsAction": "error"
      }
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120,
        "noTestsAction": "error"
      }
    },
    {
      "name": "gui-release",
      "configurePreset": "gui-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120,
        "noTestsAction": "error"
      }
    },
    {
      "name": "headless-sanitizers",
      "configurePreset": "headless-sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120,
        "noTestsAction": "error"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ]
}
