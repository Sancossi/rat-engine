<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <StridePlatform>Windows</StridePlatform>
    <StrideCurrentPackagePath>$(MSBuildThisFileDirectory)../Rat.Expedition.Authoring/Rat.Expedition.Authoring.sdpkg</StrideCurrentPackagePath>
    <StrideGraphicsApi>Direct3D11</StrideGraphicsApi>
    <StrideRemoteEffectCompilerEnabled>false</StrideRemoteEffectCompilerEnabled>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rat.Expedition.Core/Rat.Expedition.Core.csproj" />
    <ProjectReference Include="../Rat.Expedition.Authoring/Rat.Expedition.Authoring.csproj" />
    <PackageReference Include="Stride.Engine" Version="[4.4.0-dev]" />
    <PackageReference Include="Stride.AssetCompiler" Version="[4.4.0-dev]" IncludeAssets="build;buildTransitive" />
    <Content Include="../Content/**/*" Exclude="../Content/courtyard.json;../Content/sluice.json;../Content/project.json" Link="Content/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
