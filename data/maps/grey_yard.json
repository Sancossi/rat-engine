{
  "schema_version": 1,
  "id": "grey_yard",
  "width": 16,
  "height": 16,
  "tile_size": 1.0,
  "blockers": [
    { "min_x": 3.0, "min_z": -1.0, "max_x": 5.0, "max_z": 1.0 }
  ],
  "events": [
    {
      "id": "gate_sign",
      "tile": { "x": 0, "z": -3 },
      "pages": [
        {
          "trigger": "action",
          "conditions": [],
          "commands": [
            { "op": "show_text", "text": "Yard gate. Keep clear of the crates." },
            { "op": "control_switch", "id": 1, "value": true },
            { "op": "comment", "text": "Marks that the player read the sign." }
          ]
        }
      ]
    },
    {
      "id": "welcome_mat",
      "volume": { "min_x": -1.0, "min_z": -1.0, "max_x": 1.0, "max_z": 1.0 },
      "pages": [
        {
          "trigger": "player_touch",
          "conditions": [
            { "type": "switch", "id": 1, "value": false }
          ],
          "commands": [
            { "op": "show_text", "text": "Welcome to the grey yard." },
            { "op": "change_items", "id": "rusty_cog", "delta": 1, "key_item": false }
          ]
        },
        {
          "trigger": "player_touch",
          "conditions": [
            { "type": "switch", "id": 1, "value": true }
          ],
          "commands": [
            { "op": "show_text", "text": "The sign is already known." }
          ]
        }
      ]
    },
    {
      "id": "yard_intro",
      "tile": { "x": 2, "z": 2 },
      "pages": [
        {
          "trigger": "autorun",
          "conditions": [
            { "type": "variable", "id": 0, "op": "==", "value": 0 }
          ],
          "commands": [
            { "op": "show_text", "text": "Grey-box yard loaded." },
            { "op": "control_variable", "id": 0, "value": 1 },
            { "op": "wait", "frames": 1 }
          ]
        }
      ]
    }
  ]
}
